-- MECCHA CHAMELEON (PHẦN 2/3)
local function isTeammate(plr)
	if not plr or plr == localPlayer then return true end
	if localPlayer.Team and plr.Team then
		return localPlayer.Team == plr.Team
	end
	return false
end

local function getAliveHead(plr)
	local char = plr and plr.Character
	if not char then return nil, nil end
	local head = char:FindFirstChild("Head")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if head and head:IsA("BasePart") and hum and hum.Health > 0 then
		return head, char
	end
	return nil, nil
end

local function isClearLineOfSight(targetPart)
	if not state.wallCheck then return true end
	local myChar = localPlayer.Character
	local myOriginPart = myChar and (myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart"))
	if not myOriginPart or not targetPart then return false end

	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {myChar, targetPart.Parent, safeRoomModel}
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local dir = targetPart.Position - myOriginPart.Position
	local hit = Workspace:Raycast(myOriginPart.Position, dir, rayParams)
	return hit == nil
end

-- 1. Hitbox x2
local function applyHitboxX2(enabled)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer and plr.Character then
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			local head = plr.Character:FindFirstChild("Head")
			if root and root:IsA("BasePart") then
				if enabled and not isTeammate(plr) then
					if not savedHitboxSizes[root] then
						savedHitboxSizes[root] = {
							size = root.Size,
							transparency = root.Transparency,
							canCollide = root.CanCollide
						}
					end
					root.Size = savedHitboxSizes[root].size * 2
					root.Transparency = math.max(savedHitboxSizes[root].transparency, 0.75)
					root.CanCollide = false
				elseif savedHitboxSizes[root] then
					root.Size = savedHitboxSizes[root].size
					root.Transparency = savedHitboxSizes[root].transparency
					root.CanCollide = savedHitboxSizes[root].canCollide
					savedHitboxSizes[root] = nil
				end
			end
			if head and head:IsA("BasePart") then
				if enabled and not isTeammate(plr) then
					if not savedHitboxSizes[head] then
						savedHitboxSizes[head] = {
							size = head.Size,
							canCollide = head.CanCollide
						}
					end
					head.Size = savedHitboxSizes[head].size * 1.5
					head.CanCollide = false
				elseif savedHitboxSizes[head] then
					head.Size = savedHitboxSizes[head].size
					head.CanCollide = savedHitboxSizes[head].canCollide
					savedHitboxSizes[head] = nil
				end
			end
		end
	end
end

-- 2. ESP xuyên tường (team mình xanh dương, team địch đỏ ôm sát cơ thể)
local function clearEspForPlayer(plr)
	local entry = espData[plr]
	if entry then
		if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
		if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
		if entry.boxes then
			for _, box in ipairs(entry.boxes) do
				pcall(function() box:Destroy() end)
			end
		end
		espData[plr] = nil
	end
end

local function buildBodyBoxesForCharacter(char, color3)
	local boxes = {}
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			local box = Instance.new("BoxHandleAdornment")
			box.Name = "MecchaBodyBox"
			box.Adornee = part
			box.Size = part.Size + Vector3.new(0.06, 0.06, 0.06)
			box.Color3 = color3
			box.Transparency = 0.45
			box.ZIndex = 10
			box.AlwaysOnTop = true
			box.Parent = screenGui
			table.insert(boxes, box)
		end
	end
	return boxes
end

local function updateEsp()
	for plr in pairs(espData) do
		if plr.Parent ~= Players or not state.espEnabled or not plr.Character then
			clearEspForPlayer(plr)
		end
	end

	if not state.espEnabled then return end

	local myChar = localPlayer.Character
	local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer and plr.Character then
			local char = plr.Character
			local hum = char:FindFirstChildOfClass("Humanoid")
			local head = char:FindFirstChild("Head")

			if hum and hum.Health > 0 and head then
				local sameTeam = isTeammate(plr)
				local fillCol = sameTeam and Color3.fromRGB(25, 115, 255) or Color3.fromRGB(240, 40, 50)
				local outlineCol = sameTeam and Color3.fromRGB(110, 185, 255) or Color3.fromRGB(255, 105, 115)

				local entry = espData[plr]
				if not entry or entry.char ~= char or entry.sameTeam ~= sameTeam then
					clearEspForPlayer(plr)

					local hl = Instance.new("Highlight")
					hl.Name = "MecchaEspHighlight"
					hl.Adornee = char
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.FillColor = fillCol
					hl.OutlineColor = outlineCol
					hl.FillTransparency = 0.45
					hl.OutlineTransparency = 0
					hl.Parent = screenGui

					local bb = Instance.new("BillboardGui")
					bb.Name = "MecchaEspTag"
					bb.Adornee = head
					bb.Size = UDim2.new(0, 140, 0, 22)
					bb.StudsOffset = Vector3.new(0, 2.4, 0)
					bb.AlwaysOnTop = true
					bb.Parent = screenGui

					local lbl = Instance.new("TextLabel")
					lbl.Size = UDim2.new(1, 0, 1, 0)
					lbl.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
					lbl.BackgroundTransparency = 0.35
					lbl.TextColor3 = outlineCol
					lbl.Font = Enum.Font.GothamBold
					lbl.TextSize = 10
					lbl.Parent = bb
					Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 4)

					entry = {
						char = char,
						sameTeam = sameTeam,
						highlight = hl,
						billboard = bb,
						label = lbl,
						boxes = buildBodyBoxesForCharacter(char, fillCol)
					}
					espData[plr] = entry
				end

				local dist = myRoot and math.floor((head.Position - myRoot.Position).Magnitude) or 0
				local roleTag = sameTeam and "[TEAM]" or "[ĐỊCH]"
				entry.label.Text = roleTag .. " " .. plr.Name .. " | " .. tostring(dist) .. "m"
			else
				clearEspForPlayer(plr)
			end
		end
	end
end

-- Noclip
local function applyNoclip(enabled)
	local char = localPlayer.Character
	if not char then return end

	if enabled then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				if savedNoclipParts[part] == nil then
					savedNoclipParts[part] = part.CanCollide
				end
				part.CanCollide = false
			end
		end
	else
		for part, oldCollide in pairs(savedNoclipParts) do
			if part and part.Parent then
				part.CanCollide = oldCollide
			end
		end
		table.clear(savedNoclipParts)
	end
end

-- 3. Aim địch (bỏ team), Aim Check, Wall Check & Aim Silent
local function getBestEnemyHead(useCheck, useWallCheck)
	local viewportCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	local bestHead = nil
	local bestScreenDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer and not isTeammate(plr) then
			local head, _ = getAliveHead(plr)
			if head then
				local valid = true
				if useCheck then
					local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
					valid = (hum ~= nil and hum.Health > 0 and plr.Character:FindFirstChild("HumanoidRootPart") ~= nil)
				end
				if valid and (not useWallCheck or isClearLineOfSight(head)) then
					local pos, onScreen = camera:WorldToViewportPoint(head.Position)
					if onScreen and pos.Z > 0 then
						local d = (Vector2.new(pos.X, pos.Y) - viewportCenter).Magnitude
						if d < bestScreenDist then
							bestScreenDist = d
							bestHead = head
						end
					end
				end
			end
		end
	end

	return bestHead
end

local oldNamecall
pcall(function()
	oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local method = getnamecallmethod()
		if state.aimSilent and (method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist") then
			local targetHead = getBestEnemyHead(state.aimSilentCheck, state.wallCheck)
			if targetHead then
				local args = {...}
				if method == "Raycast" and typeof(args[1]) == "Vector3" then
					args[2] = (targetHead.Position - args[1]).Unit * (typeof(args[2]) == "Vector3" and args[2].Magnitude or 500)
					return oldNamecall(self, unpack(args))
				end
			end
		end
		return oldNamecall(self, ...)
	end)
end)
