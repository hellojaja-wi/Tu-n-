-- 4. Anti Void (Laser 200m -> Tường trắng -> Góc nhìn/Bay -> Nút dịch chuyển)
local function createWhiteSafeRoom(originPos)
	if safeRoomModel then
		pcall(function() safeRoomModel:Destroy() end)
		safeRoomModel = nil
	end

	local model = Instance.new("Model")
	model.Name = "MecchaWhiteSafeZone"
	model.Parent = Workspace

	local center = originPos - Vector3.new(0, 8, 0)
	local whiteMat = Enum.Material.SmoothPlastic
	local whiteCol = Color3.fromRGB(255, 255, 255)

	local floor = Instance.new("Part")
	floor.Name = "WhiteFloor"
	floor.Size = Vector3.new(36, 2, 36)
	floor.Position = center
	floor.Anchored = true
	floor.Material = whiteMat
	floor.Color = whiteCol
	floor.Parent = model

	local ceiling = Instance.new("Part")
	ceiling.Name = "WhiteCeiling"
	ceiling.Size = Vector3.new(36, 2, 36)
	ceiling.Position = center + Vector3.new(0, 18, 0)
	ceiling.Anchored = true
	ceiling.Material = whiteMat
	ceiling.Color = whiteCol
	ceiling.Parent = model

	local walls = {
		{size = Vector3.new(36, 18, 2), pos = center + Vector3.new(0, 9, 17)},
		{size = Vector3.new(36, 18, 2), pos = center + Vector3.new(0, 9, -17)},
		{size = Vector3.new(2, 18, 36), pos = center + Vector3.new(17, 9, 0)},
		{size = Vector3.new(2, 18, 36), pos = center + Vector3.new(-17, 9, 0)},
	}

	for i, w in ipairs(walls) do
		local wallPart = Instance.new("Part")
		wallPart.Name = "WhiteWall_" .. tostring(i)
		wallPart.Size = w.size
		wallPart.Position = w.pos
		wallPart.Anchored = true
		wallPart.Material = whiteMat
		wallPart.Color = whiteCol
		wallPart.Parent = model
	end

	safeRoomModel = model
	return center + Vector3.new(0, 3, 0)
end

local function enableFlightControl(root)
	if not root then return end
	floatingFlightActive = true
	if flightBodyVel then
		pcall(function() flightBodyVel:Destroy() end)
	end
	local bv = Instance.new("BodyVelocity")
	bv.Name = "MecchaFlightVel"
	bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	bv.Velocity = Vector3.zero
	bv.Parent = root
	flightBodyVel = bv
end

local function disableFlightControl()
	floatingFlightActive = false
	if flightBodyVel then
		pcall(function() flightBodyVel:Destroy() end)
		flightBodyVel = nil
	end
end

